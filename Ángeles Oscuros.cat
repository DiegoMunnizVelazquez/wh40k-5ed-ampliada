    <profile name="Land Speeder" id="9035-9efe-a190-4a12" hidden="false" page="27" publicationId="822e-763d-4a6a-b7fc" typeId="725a358c-765b-498c-8de5-399fc0c0725f" typeName="Vehículo">
      <characteristics>
        <characteristic name="HP" typeId="f6f92f00-8bb1-4afa-8ccb-46310b7dd5e5">4</characteristic>
