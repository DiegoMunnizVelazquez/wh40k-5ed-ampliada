      <profiles>
        <profile name="Belial, Señor del Ala de Muerte" id="deb6-081e-8b2b-ecc9" hidden="false" page="42" publicationId="822e-763d-4a6a-b7fc" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unidad">
